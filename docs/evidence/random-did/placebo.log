. matrix ea_b = e(b)

. matrix ea_v = e(V)

. scalar ea_df = e(df_r)

. scalar ea_n = e(N)

. file open results using placebo-coefficients.csv, write replace
(file placebo-coefficients.csv not found)

. file write results "term,estimate,std_error,p_value,ci_low,ci_high" _n

. local names : colnames ea_b

. forvalues j = 1/`=colsof(ea_b)' {
  2. local name : word `j' of `names'
  3. if "`name'" == "placebo_effect" {
  4. scalar ea_est = ea_b[1,`j']
  5. scalar ea_se = sqrt(ea_v[`j',`j'])
  6. scalar ea_p = 2*ttail(scalar(ea_df),abs(scalar(ea_est)/scalar(ea_se)))
  7. scalar ea_crit = invttail(scalar(ea_df),.025)
  8. file write results "`name'," %24.17g (scalar(ea_est)) "," %24.17g (scalar(
> ea_se)) "," %24.17g (scalar(ea_p)) "," %24.17g (scalar(ea_est)-scalar(ea_crit
> )*scalar(ea_se)) "," %24.17g (scalar(ea_est)+scalar(ea_crit)*scalar(ea_se)) _
> n
  9. }
 10. }

. file close results

. file open meta using placebo-meta.csv, write replace
(file placebo-meta.csv not found)

. file write meta "n_used,df" _n

. file write meta (scalar(ea_n)) "," (scalar(ea_df)) _n

