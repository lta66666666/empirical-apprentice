{
  "name": "empirical-apprentice-sites-local",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-22",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ea-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "ea-local" }
  ],
  "vars": { "CLEANUP_TOKEN": "local-test-only" }
}
